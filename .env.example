# Optional server-side timing overrides. Defaults match the product rules.
DRAWMORY_REVEAL_SECONDS=8
DRAWMORY_REDRAW_SECONDS=600
DRAWMORY_CONFIRMATION_SECONDS=120
DRAWMORY_LOCATION_SECONDS=900
DRAWMORY_CLAIM_SECONDS=180
DRAWMORY_WORLD_OFFER_SECONDS=90

# Owner-only administration. Generate two different random values of at least 32 bytes.
# Open /manage#access=<DRAWMORY_ADMIN_CAPABILITY>; the fragment is removed immediately.
DRAWMORY_ADMIN_CAPABILITY=replace-with-a-long-random-capability
DRAWMORY_ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret

# Set this to the trusted production origin after deployment for absolute social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
